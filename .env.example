# Supabase 
SUPABASE_URL=
SUPABASE_DB_URL=jdbc:postgresql://localhost:5432/proofly
SUPABASE_DB_URL_PY=postgresql://postgres:postgres@localhost:5432/proofly
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=postgres
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=proofly-documents

# LLM  
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Redis 
REDIS_URL=redis://localhost:6379/0

#  Search provider
SEARCH_PROVIDER=mock          
SEARCH_API_KEY=

# Reddit provider 
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=proofly-research-agent/1.0

# YouTube provider 
YOUTUBE_API_KEY=

# Demo
# When true (or when a given provider's credentials are absent), the AI service
# uses deterministic fixture data instead of live calls for that provider.
DEMO_MODE=true

# Cost / safety limits 
RESEARCH_MAX_QUERIES_PER_CHANNEL=5
RESEARCH_MAX_SOURCES=25
RESEARCH_MAX_PAGES_PER_SOURCE=1
RESEARCH_MAX_DOCUMENT_TOKENS=200000
RESEARCH_MAX_LLM_CALLS=60
RESEARCH_MAX_DURATION_SECONDS=600
RESEARCH_MAX_CONCURRENT_JOBS=3

# Internal service-to-service auth
INTERNAL_API_KEY=dev-internal-key-change-me

# Backend (Spring Boot)
SERVER_PORT=8080
JWT_ISSUER_URI=
JWT_AUDIENCE=
AI_SERVICE_URL=http://localhost:8000
RESEARCH_DISPATCH_MAX_ATTEMPTS=3
RESEARCH_DISPATCH_POLL_INTERVAL_MS=1000
RESEARCH_REAPER_INTERVAL_MS=30000
RESEARCH_SSE_TIMEOUT_SECONDS=900
RESEARCH_FOLLOWUP_TIMEOUT_SECONDS=60

# AI service (FastAPI)
AI_SERVICE_PORT=8000
BACKEND_INTERNAL_URL=http://localhost:8080
HTTP_TIMEOUT_SECONDS=20.0
HTTP_USER_AGENT=proofly-research-agent/1.0 (+https://github.com/proofly)

# Frontend (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
