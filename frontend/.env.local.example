# Frontend-only env. The root .env.example is the source of truth for the stack;
# copy these values into a frontend/.env.local when running `npm run dev` outside Docker.

# Public base URL of the Spring Boot API, including the /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Supabase Auth. When BOTH are set the app uses real Supabase auth; when either is
# empty it falls back to the documented dev-auth stub (Bearer dev-{userId}).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
